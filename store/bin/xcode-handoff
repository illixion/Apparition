#!/usr/bin/env node
'use strict';
const { capture, register, configure } = require('../lib/xcode');
const usage = 'apparition xcode snapshot --project DIR --output FILE | register --app APP [--project DIR] [--symbols DSYM] [--context FILE] | configure --spec project.yml --target TARGET [--output FILE]';
if (['--help', '-h', 'help'].includes(process.argv[2])) { console.log(usage); process.exit(0); }
try {
  const [operation, ...args] = process.argv.slice(2);
  const options = {};
  const names = { '--app': 'app', '--project': 'project', '--configuration': 'configuration', '--symbols': 'symbols',
    '--context': 'context', '--store': 'store', '--symbol-store': 'symbolStore', '--spec': 'spec', '--target': 'target', '--output': 'output' };
  for (let index = 0; index < args.length; ++index) {
    if (args[index] === '--no-generate') { options.generate = false; continue; }
    const name = names[args[index]];
    if (!name || !args[index + 1]) throw new Error('Invalid Xcode handoff option.');
    options[name] = args[++index];
  }
  let result;
  if (operation === 'snapshot' && options.project && options.output) {
    const context = capture(options.project, options.output); result = { buildId: context.buildId, context: options.output };
  } else if (operation === 'register' && options.app) {
    const registered = register(options); result = { buildId: registered.manifest.buildId, manifest: registered.path,
      platform: registered.manifest.platform, signing: registered.manifest.origin.signature };
  } else if (operation === 'configure' && options.spec && options.target) result = configure(options);
  else throw new Error('usage: ' + usage);
  console.log(JSON.stringify(result, null, 2));
} catch (error) { console.error(`Xcode handoff: ${error.message}`); process.exitCode = 1; }
