<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- AuthKit's private client entitlements, for apparition-anisette-helper. macOS refuses to run
     a program that claims them unless SIP and AMFI are off (amfi_get_out_of_my_way=1). -->
<plist version="1.0">
<dict>
	<key>com.apple.authkit.client.private</key>
	<true/>
	<key>com.apple.authkit.client.internal</key>
	<true/>
	<key>com.apple.private.alloy.anisette</key>
	<true/>
</dict>
</plist>
