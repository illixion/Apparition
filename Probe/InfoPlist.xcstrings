    "NSLocalNetworkUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apparition finds this device's own developer services, an Apparition companion on your computer, and your other devices that share a signing key, and connects to them and to the build service you set up."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is needed to keep Apparition running in the background while it is an app's JIT debugger, so the app keeps its JIT. Apparition never reads, stores or sends your location."
          }
        }
      }
    }
  },
  "version" : "1.0"
