# Copy to <repo>/scripts/build-signing.conf (or <repo>/build-signing.conf)
# and keep it out of version control.

PROJECT_PATH="MyApp.xcodeproj"      # or a .xcworkspace
SCHEME_NAME="MyApp"
TARGET_NAME="MyApp"
# Respect the caller's PLATFORM (the appstore sets it), default otherwise.
PLATFORM="${PLATFORM:-iOS}"

# The bundle id the signed app gets. With a wildcard profile this can be
# anything under your team.
BUILD_BUNDLE_ID="com.example.myapp"

# Name as `xcrun devicectl list devices` prints it.
DEVICE_NAME="My iPhone"

# Optional:
# PRE_BUILD_HOOK="scripts/fetch-deps.sh"
# EXTRA_BUILD_SETTINGS=('SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) MY_FLAG')
#
# Aliases that aren't real Xcode platforms: reach several devices from one build.
# case "$PLATFORM" in
#   iPad) PLATFORM=iOS; DEVICE_NAME="My iPad" ;;
# esac
