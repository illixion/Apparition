<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Music's Android libraries, which the Android anisette loads and maps executable
	     (core/src/anisette/elf.rs; switched by anisette::ANDROID_LIBRARIES). The hardened runtime
	     kills the app on the first instruction it runs from such a page unless this is allowed. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
