{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apparition",
  "mainBinaryName": "Apparition",
  "identifier": "com.illixion.apparition.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Apparition",
        "width": 980,
        "height": 700,
        "minWidth": 780,
        "minHeight": 600,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Puts Apparition on your Apple devices, and is its companion",
    "longDescription": "Installs Apparition, the on-device sideloader, on Vision Pro, iPhone, iPad and Apple TV (pair over Wi-Fi, sign with your Apple ID or your own certificate, install), then stays in the menu bar or tray as the companion it uses: the relay to its own device and an anisette server for signing in to Apple.",
    "copyright": "MIT licensed",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
