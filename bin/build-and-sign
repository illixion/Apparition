#!/opt/homebrew/bin/bash
set -euo pipefail

# Build and sign an app for device deployment.
#
# All signing material (certs, profiles, passwords) is read from
# build-signing.conf — nothing needs to be in the login keychain, so this
# works over SSH.
#
# Usage (run from anywhere inside the target repo):
#   build-and-sign                  # Release build + deploy (dev-signed)
#   build-and-sign --debug          # Debug build + deploy
#   build-and-sign --distribution   # Sign with the distribution cert/profile
#   build-and-sign --no-deploy      # Sign but don't install to device
#   build-and-sign --sign-only      # Skip build, sign existing IPA
#   build-and-sign --ipa path.ipa   # Sign a specific IPA (implies --sign-only)
#   build-and-sign --profile FILE   # Sign the development build with this profile instead
#   build-and-sign --platform iOS   # Build for a platform other than the conf's
#   build-and-sign --device MyPhone # Install to a device other than the conf's
#   build-and-sign --set KEY=VALUE  # Extra xcodebuild setting (repeatable)
#   build-and-sign --run            # Launch the app on the device after install. Only
#                                   # --run (or --log/--log-all) launches; without it
#                                   # the app is installed and updated in the background
#   build-and-sign --log            # --run, plus stream the app's console to
#                                   # build/device-console.log in the background
#                                   # (tail -f it; stop with the printed kill cmd).
#                                   # Apps built with DebugTrace log only their own
#                                   # lines there, compact and redacted
#   build-and-sign --log-all        # --log, but mirror the whole unified log
#                                   # (Apple frameworks too) instead
#   build-and-sign --run --mcp      # Launch as a debug session: --log, plus the
#                                   # debug server for this launch, registered for
#                                   # the agents' `apps` MCP server
#                                   # (DebugTrace/Tools/debugtrace-mcp). --mcp never
#                                   # launches on its own. MCP_DEFAULT=on in global.conf
#                                   # (or a repo conf) makes every --run of a
#                                   # development build a debug session
#   build-and-sign --run --no-mcp   # A bare launch, even when MCP_DEFAULT=on
#   build-and-sign --inject         # Build so running code can be patched live
#                                   # (testability + dynamic replacement) and keep
#                                   # what the `inject` tool needs in build/inject/, and
#                                   # embed the patch runtime (Frameworks/DebugTraceInject.dylib)
#                                   # that DebugTraceServer loads. DEBUGTRACE_INJECT=off in a
#                                   # repo's build-signing.conf refuses the flag for that repo.
#                                   # INJECT_SCOPE=app (conf or env) makes only the app's own
#                                   # module patchable and keeps packages fully optimized:
#                                   # about half the frame cost in Oneiros (+11-15% vs +28-35%).
#                                   # Development builds only; implies --debug off
#   build-and-sign --sign-dylib F.. # Sign Mach-O files with the development
#                                   # identity (last option: it takes the files).
#                                   # What `inject` uses to sign a patch
#
# It resolves the project root from the CURRENT git repo and reads that
# repo's build-signing.conf, either <root>/scripts/build-signing.conf or
# <root>/build-signing.conf, after the shared ~/.config/build-signing/global.conf.
# See the README for the conf variables.
# Requires Node 18+ and the complete build tools checkout for artifact manifests.

# --help has to work before any signing config exists.
for arg in "$@"; do
    case "$arg" in
        -h|--help) awk 'NR>3 { if (/^#/) { sub(/^# ?/, ""); print } else exit }' "$0"; exit 0 ;;
    esac
done

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# Some repos (a harness around a prebuilt app) do not have an Xcode
# project at all: they ship a prebuilt .ipa or .app bundle and rely on the
# shared appstore flow to sign + install that artifact. Detect those repos and
# convert the build into a sign-only deploy automatically.
find_static_ipa() {
    local candidate=""
    local dir
    # $BUILD_DIR (repo/build) is build-and-sign's own scratch/output area —
    # DerivedData, the repacked Payload, and every signed IPA it has ever
    # produced live there. It must never be a candidate SOURCE: a stale
    # "${TARGET_NAME}-signed.ipa" from a past run sitting in a directory
    # that happens to sort before the real source (byte-wise, "build" < "iOS")
    # would otherwise get silently re-signed as if it were fresh input —
    # this has bitten static-IPA repos repeatedly. Excluding it
    # here, rather than just deleting stale outputs per-repo, fixes the bug
    # for every repo that ever uses this discovery path, not just one.
    for dir in "$PROJECT_ROOT" "$PROJECT_ROOT/ipa-build" "$PROJECT_ROOT/iOS"; do
        [[ -d "$dir" ]] || continue
        candidate=$(find "$dir" -type f \( -iname '*.ipa' -o -iname '*.zip' \) \
            -not -path "$BUILD_DIR/*" 2>/dev/null | sort | head -1)
        if [[ -n "$candidate" ]]; then
            INPUT_IPA="$candidate"
            SIGN_ONLY=true
            TARGET_NAME="${TARGET_NAME:-$(basename "${candidate%.*}")}"
            return 0
        fi
    done
    return 1
}

# All build/codesign/devicectl chatter  (including Xcode's harmless device
# preflight noise — DTDKRemoteDeviceConnection / notification_proxy / "device
# is passcode protected", which fires on any build with a device attached
# regardless of destination or signing settings) goes here instead of the
# terminal. On failure we grep this for the real error and point at the file;
# on success we never print it. Lives in build/ (not the WORK_DIR tmpdir) so
# it survives the EXIT cleanup trap for post-mortem.
BUILD_DIR="$PROJECT_ROOT/build"
mkdir -p "$BUILD_DIR"
LOG_FILE="$BUILD_DIR/last-build.log"   # truncated once the build lock is held (see "Main")

# Patterns that are always noise, never signal — filtered out of whatever we
# show the user, whether that's a success summary or an error excerpt.
NOISE_PATTERN='DTDKRemoteDeviceConnection|notification_proxy|MobileDeviceErrorDomain|dtdevicekit\.stacktrace|^\s*[0-9]+\s+DT[A-Za-z]+|^\s*[0-9]+\s+libdispatch|^\s*[0-9]+\s+DVTFoundation|^\s*[0-9]+\s+IDEDevice|^\s*[0-9]+\s+Xcode3Core|^\s*[0-9]+\s+IDEFoundation'

on_error() {
    local exit_code=$?
    local line="$1"
    echo "" >&2
    echo "✗ Failed (exit $exit_code, line $line)" >&2
    if [[ -s "$LOG_FILE" ]]; then
        local excerpt
        excerpt=$(grep -E -i 'error:|BUILD FAILED|failed with exit code' "$LOG_FILE" | grep -Ev "$NOISE_PATTERN" | tail -25)
        if [[ -n "$excerpt" ]]; then
            echo "---- error ----" >&2
            echo "$excerpt" >&2
        else
            echo "(no specific error line matched — see full log)" >&2
        fi
    fi
    echo "Full log: $LOG_FILE" >&2
}
trap 'on_error $LINENO' ERR

# --- Load configuration ---
# Two layers: a global conf holds the shared signing material (certs,
# profiles, passwords, team), the repo conf holds project specifics
# (PROJECT_PATH, SCHEME_NAME, PLATFORM, DEVICE_NAME, BUILD_BUNDLE_ID) and
# may override anything global. At least one must exist; the repo conf is
# sourced second so it wins.
#
# Every repo conf is expected to respect the caller's environment itself —
# `PLATFORM="${PLATFORM:-visionOS}"` (falling back to its own default only
# when unset) rather than assigning unconditionally. A conf may also branch
# on that value to implement aliases that aren't real Xcode platforms (e.g.
# PLATFORM=iPad → PLATFORM=iOS with a different DEVICE_NAME). Do NOT
# reassert the caller's raw PLATFORM/DEVICE_NAME after sourcing — that would
# clobber a conf's alias translation right back to the un-translated value
# (PLATFORM=iPad is not a valid `-destination generic/platform=` value on
# its own). A --platform / --device flag still outranks the conf and is
# applied after parsing, below.
GLOBAL_CONF="${BUILD_SIGNING_GLOBAL_CONF:-$HOME/.config/build-signing/global.conf}"
CONF_FILE=""
for c in "$PROJECT_ROOT/scripts/build-signing.conf" "$PROJECT_ROOT/build-signing.conf"; do
    [[ -f "$c" ]] && { CONF_FILE="$c"; break; }
done
if [[ ! -f "$GLOBAL_CONF" && -z "$CONF_FILE" ]]; then
    echo "ERROR: No config found — need $GLOBAL_CONF and/or a repo build-signing.conf" >&2
    echo "       (looked in $PROJECT_ROOT/scripts/ and $PROJECT_ROOT/)" >&2
    exit 1
fi
# The conf's BUILD_BUNDLE_ID is a default for the repo's own build. Remember whether the
# caller really set one, so an --ipa keeps its own bundle ID (see Step 4.5).
ENV_BUILD_BUNDLE_ID="${BUILD_BUNDLE_ID:-}"
[[ -f "$GLOBAL_CONF" ]] && source "$GLOBAL_CONF"
[[ -n "$CONF_FILE" ]] && source "$CONF_FILE"

# Defaults for optional config values
PLATFORM="${PLATFORM:-visionOS}"
TARGET_NAME="${TARGET_NAME:-${SCHEME_NAME:-}}"
P12_PASSWORD="${P12_PASSWORD:-}"
DEV_P12_PASSWORD="${DEV_P12_PASSWORD:-$P12_PASSWORD}"
DIST_P12_PASSWORD="${DIST_P12_PASSWORD:-$P12_PASSWORD}"
PRE_BUILD_HOOK="${PRE_BUILD_HOOK:-}"
# Extra xcodebuild settings (bash array), e.g. compilation conditions:
#   EXTRA_BUILD_SETTINGS=('SWIFT_ACTIVE_COMPILATION_CONDITIONS=$(inherited) SOME_FLAG')
if [[ -z "${EXTRA_BUILD_SETTINGS+x}" ]]; then EXTRA_BUILD_SETTINGS=(); fi

# --- Parse arguments ---
CONFIG="Release"
SIGN_ONLY=false
NO_DEPLOY=false
USE_DIST=false
RUN_APP=false
LOG_APP=false
LOG_ALL=false
MCP_SESSION=false
MCP_REQUEST=""      # "on"/"off" from --mcp/--no-mcp; else MCP_DEFAULT decides
INJECT=false
SIGN_DYLIBS=()
INPUT_IPA=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --debug)         CONFIG="Debug"; shift ;;
        --distribution)  USE_DIST=true; shift ;;
        --sign-only)     SIGN_ONLY=true; shift ;;
        --no-deploy)     NO_DEPLOY=true; shift ;;
        --run)           RUN_APP=true; shift ;;
        --log)           RUN_APP=true; LOG_APP=true; shift ;;
        --log-all)       RUN_APP=true; LOG_APP=true; LOG_ALL=true; shift ;;
        --mcp)           MCP_REQUEST=on; shift ;;
        --no-mcp)        MCP_REQUEST=off; shift ;;
        --inject)        INJECT=true; shift ;;
        --sign-dylib)    shift; SIGN_DYLIBS=("$@"); SIGN_ONLY=true; NO_DEPLOY=true; TARGET_NAME="${TARGET_NAME:-dylib}"; shift $# ;;
        --platform)      PLATFORM="$2"; shift 2 ;;
        --device)        DEVICE_NAME="$2"; shift 2 ;;
        --set)           EXTRA_BUILD_SETTINGS+=("$2"); shift 2 ;;
        --ipa)           INPUT_IPA="$2"; SIGN_ONLY=true; shift 2 ;;
        --profile)       FORCE_PROFILE="$2"; shift 2 ;;
        -h|--help)
            awk 'NR>3 { if (/^#/) { sub(/^# ?/, ""); print } else exit }' "$0"
            exit 0
            ;;
        *) echo "Unknown option: $1"; exit 1 ;;
    esac
done

# --profile FILE: sign the development build with this profile instead of the conf's (for
# an IPA whose bundle ID the conf's profile doesn't cover). The conf and its certificate stay.
if [[ -n "${FORCE_PROFILE:-}" ]]; then
    [[ -f "$FORCE_PROFILE" ]] || { echo "ERROR: --profile $FORCE_PROFILE not found" >&2; exit 1; }
    DEV_PROFILE_PATH="$FORCE_PROFILE"
fi

# Launching is --run's alone (--log/--log-all include it). --mcp/--no-mcp and
# MCP_DEFAULT only decide what a launch is: with --mcp, or MCP_DEFAULT=on and
# no --no-mcp, a --run of a development build launches as a debug session
# (console attached, session registered). Without --run nothing launches and
# the app updates in the background, whatever the MCP setting; its debug
# server still starts on the next launch (CommandToken, below), so a client
# can attach then. Resolved after parsing, so flag order never matters.
if [[ "$RUN_APP" == true && "$MCP_REQUEST" != off && "$USE_DIST" == false \
      && ( "$MCP_REQUEST" == on || "${MCP_DEFAULT:-off}" == on ) ]]; then
    case "$PLATFORM" in
        [mM][aA][cC][oO][sS]|[oO][sS][xX]) ;;
        *) LOG_APP=true; MCP_SESSION=true ;;
    esac
elif [[ "$MCP_REQUEST" == on && "$RUN_APP" == false && "$NO_DEPLOY" == false ]]; then
    echo "NOTE: --mcp without --run installs only; add --run to launch as a debug session" >&2
fi

# Xcode's incremental build cache. One per checkout, never shared between a
# main checkout and its worktrees or clones: those build different source
# trees (an apple-worktree's packages are APFS clones at other paths, a store
# build clone is another directory), so a shared cache is rebuilt by every
# build and corrupted by two at once, while a per-checkout one dies with its
# checkout (`apple-worktree remove`, a reboot's /private/tmp, the store's
# clone reaper). It used to hang off the git common dir, which did exactly
# that sharing.
# --inject gets its own: its modules carry the patching flags and are what
# `inject` compiles patches against, so a plain build (or a deploy without
# --inject) into the same directory silently replaced them, and the next
# `inject` failed with "module was not compiled for private import".
if [[ "$INJECT" == true ]]; then
    DERIVED_DATA_PATH="$BUILD_DIR/DerivedData-inject"
else
    DERIVED_DATA_PATH="$BUILD_DIR/DerivedData"
fi

# Static-IPA repos are the ones with no Xcode project configured. When the
# conf sets PROJECT_PATH we must always build — otherwise the IPA left in
# build/ by a previous run gets picked up here and silently re-signed, and
# the device receives a stale binary on every second invocation.
if [[ "$SIGN_ONLY" == false && -z "${PROJECT_PATH:-}" ]]; then
    find_static_ipa || true
fi

# PLATFORM -> the SDK name xcodebuild stamps into a built bundle's
# DTPlatformName, and the suffix of its DerivedData products directory.
# Computed here rather than inside the build branch so that --sign-only and
# --ipa runs, which never build, can still use it for the platform check at
# unpack time. Empty means a platform this script does not know; the checks
# that read it then skip themselves instead of guessing.
case "${PLATFORM:-}" in
    [iI][oO][sS])                       EXPECTED_SDK="iphoneos" ;;
    [vV]ision[oO][sS]|[xX][rR][oO][sS]) EXPECTED_SDK="xros" ;;
    [tT][vV][oO][sS])                   EXPECTED_SDK="appletvos" ;;
    [wW]atch[oO][sS])                   EXPECTED_SDK="watchos" ;;
    [mM]ac[oO][sS]|[oO][sS][xX])        EXPECTED_SDK="macosx" ;;
    *)                                  EXPECTED_SDK="" ;;
esac
if [[ -n "$EXPECTED_SDK" && "$EXPECTED_SDK" != "macosx" ]]; then
    PRODUCT_SUBDIR="${CONFIG}-${EXPECTED_SDK}"
elif [[ "$EXPECTED_SDK" == "macosx" ]]; then
    PRODUCT_SUBDIR="${CONFIG}"
else
    PRODUCT_SUBDIR="${CONFIG}-*"
fi

MACOS_BUILD=false
if [[ "$EXPECTED_SDK" == "macosx" ]]; then
    MACOS_BUILD=true
    if [[ "$RUN_APP" == true || "$LOG_APP" == true || "$MCP_REQUEST" == on ]]; then
        echo "ERROR: macOS builds produce a .app for manual copying; --run/--log/--mcp are device-only options." >&2
        exit 1
    fi
    if [[ "$USE_DIST" == true ]]; then
        echo "ERROR: --distribution is not supported for macOS builds; use a Developer ID signing workflow." >&2
        exit 1
    fi
    if [[ "$SIGN_ONLY" == true || -n "$INPUT_IPA" ]]; then
        echo "ERROR: macOS mode builds a fresh .app; --sign-only/--ipa are for mobile IPA files." >&2
        exit 1
    fi
    NO_DEPLOY=true
fi

CONF_LABEL="${CONF_FILE:-$GLOBAL_CONF}"
if [[ "$SIGN_ONLY" == true && -z "$TARGET_NAME" && -n "$INPUT_IPA" ]]; then
    TARGET_NAME="$(basename "${INPUT_IPA%.*}")"
fi
if [[ "$SIGN_ONLY" == true && "$NO_DEPLOY" == false && -z "${DEVICE_NAME:-}" ]]; then
    NO_DEPLOY=true
fi

required_vars=(TEAM_ID DEV_P12_PATH)
[[ "$MACOS_BUILD" == true ]] || required_vars+=(DEV_PROFILE_PATH)
if [[ "$USE_DIST" == true ]]; then
    required_vars+=(DIST_P12_PATH DIST_PROFILE_PATH)
fi
if [[ "$SIGN_ONLY" == false ]]; then
    required_vars+=(PROJECT_PATH SCHEME_NAME PLATFORM)
else
    required_vars+=(TARGET_NAME)
fi
if [[ "$NO_DEPLOY" == false || "$RUN_APP" == true ]]; then
    required_vars+=(DEVICE_NAME)
fi
for var in "${required_vars[@]}"; do
    if [[ -z "${!var:-}" ]]; then
        echo "ERROR: Required variable $var is not set in ${CONF_LABEL:-<unknown>}" >&2
        exit 1
    fi
done

if [[ "$USE_DIST" == true ]]; then
    P12_PATH="$DIST_P12_PATH"
    P12_PW="$DIST_P12_PASSWORD"
    PROFILE_PATH="$DIST_PROFILE_PATH"
    [[ -n "$P12_PATH" && -n "$PROFILE_PATH" ]] || {
        echo "ERROR: --distribution requires DIST_P12_PATH and DIST_PROFILE_PATH in $CONF_FILE" >&2
        exit 1
    }
else
    P12_PATH="$DEV_P12_PATH"
    P12_PW="$DEV_P12_PASSWORD"
    PROFILE_PATH="${DEV_PROFILE_PATH:-}"
fi

# An embedded watchOS companion app is installed by the WATCH's installd, which
# validates the profile against the WATCH's UDID and the watchOS platform — the
# iOS profile satisfies neither, so the phone-side install succeeds and the
# watch-side one fails with a bare "Could not install at this time"
# (0xe8008012). Point {DEV,DIST}_WATCH_PROFILE_PATH at a watchOS profile that
# lists the paired watch, and Watch/*.app gets that profile + its entitlements
# instead of the app's. Unset → the app profile is reused (old behavior).
if [[ "$USE_DIST" == true ]]; then
    WATCH_PROFILE_PATH="${DIST_WATCH_PROFILE_PATH:-}"
else
    WATCH_PROFILE_PATH="${DEV_WATCH_PROFILE_PATH:-}"
fi

# An app extension gets the app's profile and entitlements by default, which
# only works when the profile is a wildcard covering both bundle ids. With an
# explicit App ID the appex needs its own: signing it with the app's
# entitlements claims the app's application-identifier for a differently-named
# bundle, and installd rejects the pair (error 3002). Point
# {DEV,DIST}_APPEX_PROFILE_PATH at the extension's own profile, and set
# APPEX_BUNDLE_ID to the id that profile is for. Unset → the app profile is
# reused and the id stays "${BUILD_BUNDLE_ID}.broadcast" (old behavior).
if [[ "$USE_DIST" == true ]]; then
    APPEX_PROFILE_PATH="${DIST_APPEX_PROFILE_PATH:-}"
else
    APPEX_PROFILE_PATH="${DEV_APPEX_PROFILE_PATH:-}"
fi

for f in "$P12_PATH" ${PROFILE_PATH:+"$PROFILE_PATH"} ${WATCH_PROFILE_PATH:+"$WATCH_PROFILE_PATH"} \
         ${APPEX_PROFILE_PATH:+"$APPEX_PROFILE_PATH"}; do
    [[ -f "$f" ]] || { echo "ERROR: File not found: $f" >&2; exit 1; }
done

# --- Work dir + cleanup ---
WORK_DIR=$(mktemp -d)
KEYCHAIN_PATH=""
ORIGINAL_KEYCHAINS=""

# --- Cross-process signing lock ---
# security's user keychain search list is a per-login-session resource, not
# a per-process one: `codesign --keychain` is well known to NOT reliably
# scope identity lookup to just that keychain (it's a longstanding macOS
# quirk — see fastlane/match and countless CI threads), so setup_signing_keychain
# below still has to prepend our temp keychain to the *global* search list
# for signing to find it, then cleanup() restores exactly what it captured
# as "original". If two build-and-sign processes are both inside that
# setup..cleanup window at once (e.g. two different repos' builds running
# concurrently under the appstore server), the second one's "original" list
# already includes the first one's temp keychain, and whichever finishes
# first restores a list that's stale for the other — silently breaking
# codesign identity lookup or leaking a temp keychain into the permanent
# search list. A simple directory-based mutex around that whole window
# turns concurrent signing into a queue instead of a race, without
# serializing the (much longer) xcodebuild step before it.
SIGNING_LOCK_DIR="${TMPDIR:-/tmp}/build-and-sign.keychain.lock"
SIGNING_LOCK_HELD=false

acquire_signing_lock() {
    local waited=0
    while true; do
        if mkdir "$SIGNING_LOCK_DIR" 2>/dev/null; then
            echo $$ > "$SIGNING_LOCK_DIR/pid" 2>/dev/null || true
            SIGNING_LOCK_HELD=true
            return 0
        fi
        # Stale lock from a process that died without running its EXIT trap
        # (kill -9, power loss) — if the pid it recorded isn't running
        # anymore, it's safe to steal. mkdir below stays the sole point of
        # atomicity; a second waiter losing the race here just loops back.
        local holder_pid
        holder_pid=$(cat "$SIGNING_LOCK_DIR/pid" 2>/dev/null || echo "")
        if [[ -n "$holder_pid" ]] && ! kill -0 "$holder_pid" 2>/dev/null; then
            # rmdir refuses a non-empty dir (it holds pid) — rm -rf it
            rm -rf "$SIGNING_LOCK_DIR" 2>/dev/null || true
            continue
        fi
        waited=$((waited + 1))
        if (( waited > 3000 )); then  # ~10 minutes at 0.2s
            echo "ERROR: timed out waiting for another build-and-sign to finish signing (lock held by pid ${holder_pid:-unknown} at $SIGNING_LOCK_DIR)" >&2
            exit 1
        fi
        sleep 0.2
    done
}

release_signing_lock() {
    [[ "$SIGNING_LOCK_HELD" == true ]] || return 0
    rm -rf "$SIGNING_LOCK_DIR" 2>/dev/null || true
    SIGNING_LOCK_HELD=false
}

# --- Per-checkout build lock ---
# Two build-and-sign runs in one checkout (an agent and the store, two agents)
# share build/: DerivedData, the repacked Payload, the IPA, the logs, the
# inject record. Run together they corrupt each other's build, so the second
# waits. Other checkouts (worktrees, clones) have their own build/ and run
# freely. Held until exit; the app's console stream is a detached process, so
# `--log`/`--mcp` runs still release it as soon as the launch is done.
BUILD_LOCK_DIR="$BUILD_DIR/.build-and-sign.lock"
BUILD_LOCK_HELD=false

build_lock_holder_alive() {
    local pid="$1"
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && ps -p "$pid" -o command= 2>/dev/null | grep -q build-and-sign
}

acquire_build_lock() {
    local waited=0 holder=""
    while ! mkdir "$BUILD_LOCK_DIR" 2>/dev/null; do
        holder=$(cat "$BUILD_LOCK_DIR/pid" 2>/dev/null || true)
        # A holder that died without its EXIT trap (kill -9, power loss) or whose pid
        # is now some other process, or a lock that never got its pid: steal it. The
        # rename is atomic, so of several waiters exactly one clears it.
        if { [[ -n "$holder" ]] && ! build_lock_holder_alive "$holder"; } \
           || { [[ -z "$holder" ]] && [[ -n "$(find "$BUILD_LOCK_DIR" -maxdepth 0 -mmin +1 2>/dev/null)" ]]; }; then
            if mv "$BUILD_LOCK_DIR" "$BUILD_LOCK_DIR.stale.$$" 2>/dev/null; then
                rm -rf "$BUILD_LOCK_DIR.stale.$$"
            fi
            continue
        fi
        if (( waited == 0 )); then
            echo "==> Another build-and-sign (pid ${holder:-?}) is building in $PROJECT_ROOT; waiting for it (they share build/)" >&2
        fi
        waited=$((waited + 1))
        if (( waited > 2400 )); then   # ~40 minutes at 1 s
            echo "ERROR: gave up waiting for build-and-sign pid ${holder:-?} in $PROJECT_ROOT ($BUILD_LOCK_DIR)." >&2
            echo "       If it is stuck, stop that pid; a dead holder's lock is cleared automatically." >&2
            exit 1
        fi
        sleep 1
    done
    echo $$ > "$BUILD_LOCK_DIR/pid"
    BUILD_LOCK_HELD=true
    (( waited == 0 )) || echo "==> Lock acquired after ${waited}s" >&2
}

release_build_lock() {
    [[ "$BUILD_LOCK_HELD" == true ]] || return 0
    rm -rf "$BUILD_LOCK_DIR" 2>/dev/null || true
    BUILD_LOCK_HELD=false
}

# build-and-sign has two stable caches per checkout. Older versions and
# ad-hoc xcodebuild invocations left additional DerivedData trees alongside
# them (often with a different scheme/platform in the name), and those grew
# without limit. Once this checkout's build lock is held, discard only
# direct-child Xcode DerivedData trees that are not either stable cache.
# Archives, IPAs, app bundles, logs, screenshots, and Xcode's global
# ~/Library/Developer/Xcode/DerivedData are outside this match.
prune_legacy_derived_data() {
    local candidate
    for candidate in "$BUILD_DIR"/*; do
        [[ -d "$candidate" && ! -L "$candidate" ]] || continue
        [[ "$candidate" == "$BUILD_DIR/DerivedData" || \
           "$candidate" == "$BUILD_DIR/DerivedData-inject" ]] && continue
        if [[ -f "$candidate/Info.plist" && \
              -d "$candidate/Build/Products" && \
              -d "$candidate/Build/Intermediates.noindex" ]]; then
            echo "==> Removing legacy DerivedData cache: $candidate"
            rm -rf -- "$candidate"
        fi
    done
}

cleanup() {
    if [[ -n "$KEYCHAIN_PATH" && -f "$KEYCHAIN_PATH" ]]; then
        if [[ -n "$ORIGINAL_KEYCHAINS" ]]; then
            # shellcheck disable=SC2086
            security list-keychains -d user -s $ORIGINAL_KEYCHAINS >/dev/null 2>&1 || true
        fi
        security delete-keychain "$KEYCHAIN_PATH" >/dev/null 2>&1 || true
    fi
    # Release the lock only after the search list is fully restored, so a
    # process that was waiting on it never observes a half-restored state.
    release_signing_lock
    release_build_lock
    [[ -n "${WORK_DIR:-}" ]] && rm -rf "$WORK_DIR"
}
trap cleanup EXIT

# --- Helpers ---

# Create a temporary keychain and import the given .p12 into it.
# Sets SIGN_IDENTITY to the SHA1 of the imported signing identity.
# Must be called directly, NOT via $(...): it sets KEYCHAIN_PATH and
# ORIGINAL_KEYCHAINS for the EXIT trap, and a command-substitution
# subshell would discard them — leaking the temp keychain into the
# user search list on every build.
setup_signing_keychain() {
    local p12="$1"
    local p12_password="$2"

    KEYCHAIN_PATH="$WORK_DIR/signing.keychain-db"
    local keychain_pass
    keychain_pass="$(openssl rand -hex 16)"

    security create-keychain -p "$keychain_pass" "$KEYCHAIN_PATH" >/dev/null
    security set-keychain-settings -lut 3600 "$KEYCHAIN_PATH" >/dev/null
    security unlock-keychain -p "$keychain_pass" "$KEYCHAIN_PATH" >/dev/null

    # Prepend our keychain to the user search list so codesign can find it.
    ORIGINAL_KEYCHAINS=$(security list-keychains -d user | sed -E 's/^[[:space:]]*"?//; s/"?[[:space:]]*$//' | tr '\n' ' ')
    # shellcheck disable=SC2086
    security list-keychains -d user -s "$KEYCHAIN_PATH" $ORIGINAL_KEYCHAINS >/dev/null

    security import "$p12" -k "$KEYCHAIN_PATH" -P "$p12_password" \
        -T /usr/bin/codesign -T /usr/bin/security >/dev/null
    security set-key-partition-list -S apple-tool:,apple: -s -k "$keychain_pass" "$KEYCHAIN_PATH" >/dev/null 2>&1 || true

    local sha1
    sha1=$(security find-identity -v -p codesigning "$KEYCHAIN_PATH" \
        | awk '/^[[:space:]]*[0-9]+\)/ {print $2; exit}')
    if [[ -z "$sha1" ]]; then
        echo "ERROR: No code-signing identity found in $p12" >&2
        echo "       (is the password correct?)" >&2
        exit 1
    fi
    SIGN_IDENTITY="$sha1"
}

extract_entitlements() {
    local profile_path="$1"
    local entitlements_plist="$2"
    security cms -D -i "$profile_path" 2>/dev/null \
        | plutil -extract Entitlements xml1 -o "$entitlements_plist" -- -
}

# Merge extra entitlements into the profile-derived plist BEFORE signing.
# CAUTION: installd DOES validate signed entitlements against the
# provisioning profile — a merged key the profile does not grant fails the
# install with CoreDeviceError 3002. Only merge keys the target profile
# grants. Set EXTRA_ENTITLEMENTS_PLIST in a conf to a plist fragment; missing
# file is a no-op. PlistBuddy Merge is additive (won't clobber existing keys).
merge_extra_entitlements() {
    local entitlements_plist="$1"
    local extra_plist="${2:-}"
    [[ -n "$extra_plist" && -f "$extra_plist" ]] || return 0
    echo "==> Merging extra entitlements from $(basename "$extra_plist")"
    /usr/libexec/PlistBuddy -c "Merge $extra_plist" "$entitlements_plist"
}

# Replace the associated-domains grant placeholder with a concrete list.
# Development profiles for App IDs with the Associated Domains capability
# carry `com.apple.developer.associated-domains = *` — a wildcard *grant*,
# not a usable value (the entitlement must be an array of "service:domain"
# strings; Xcode normally substitutes the app's own list from its
# .entitlements). Signing the placeholder verbatim leaves the app associated
# with nothing. A conf sets ASSOCIATED_DOMAINS to a space-separated list
# (e.g. "webcredentials:example.com webcredentials:example.com?mode=developer")
# to substitute; unset leaves the plist untouched. Concrete values are within
# the wildcard grant, so installd accepts them.
substitute_associated_domains() {
    local entitlements_plist="$1"
    local domains="${2:-}"
    [[ -n "$domains" ]] || return 0
    echo "==> Substituting associated-domains: $domains"
    /usr/libexec/PlistBuddy -c "Delete :com.apple.developer.associated-domains" \
        "$entitlements_plist" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c "Add :com.apple.developer.associated-domains array" \
        "$entitlements_plist"
    local domain index=0
    for domain in $domains; do
        /usr/libexec/PlistBuddy \
            -c "Add :com.apple.developer.associated-domains:$index string $domain" \
            "$entitlements_plist"
        index=$((index + 1))
    done
}

# Signs $app_path (inside-out: dylibs/frameworks, then extensions, then the
# watch companion, then the outer bundle) and leaves the count of signed
# bundles/binaries in the global SIGNED_COUNT for the final report. Sets it
# directly rather than `echo`ing a return value from a $(...) subshell: on
# macOS's system /bin/bash (3.2, no `inherit_errexit`), `set -e` does not
# propagate into a command-substitution subshell, so a failing codesign
# inside one would be silently swallowed instead of aborting the script.
# All codesign chatter goes to $log; only a failure surfaces (set -e + the
# ERR trap print the log excerpt and abort).
SIGNED_COUNT=0
sign_app() {
    local app_path="$1"
    local identity="$2"
    local entitlements="$3"
    local keychain="$4"
    local log="$5"
    local count=0

    # Sign all embedded dylibs and frameworks first (deepest items first).
    # Process substitution (not a pipe) so `count` updates in this scope
    # instead of a throwaway subshell.
    while read -r item; do
        codesign --force --sign "$identity" --keychain "$keychain" --timestamp=none "$item" >>"$log" 2>&1
        count=$((count + 1))
    done < <(find "$app_path" \( -name "*.dylib" -o -name "*.framework" \))

    # Sign nested app extensions before the outer bundle (inside-out rule).
    # The app's entitlements by default, which is right for a wildcard profile
    # covering every bundle id; APPEX_ENTITLEMENTS_PLIST (set in Step 3 when an
    # appex profile is configured) overrides that for an extension with an App
    # ID of its own. Guard the directory: apps that ship no extensions have no
    # PlugIns/, and `find` on a missing path exits 1, which `set -euo pipefail`
    # turns into a silent mid-sign abort. ExtensionKit extensions sit in
    # Extensions/ rather than PlugIns/ and are signed the same way.
    local appex_dir
    for appex_dir in "$app_path/PlugIns" "$app_path/Extensions"; do
        [[ -d "$appex_dir" ]] || continue
        local appex_entitlements="${APPEX_ENTITLEMENTS_PLIST:-$entitlements}"
        while read -r appex; do
            codesign --force --sign "$identity" --keychain "$keychain" \
                --entitlements "$appex_entitlements" --timestamp=none "$appex" >>"$log" 2>&1
            count=$((count + 1))
        done < <(find "$appex_dir" -maxdepth 1 -name '*.appex' -type d)
    done

    # Sign an embedded watchOS companion app (app_path/Watch/*.app) inside-out
    # before the outer bundle. Guard the directory: apps without a paired watch
    # app have no Watch/, and `find` on a missing path exits 1 → set -e abort.
    # WATCH_ENTITLEMENTS_PLIST (set in Step 3 when a watch profile is
    # configured) carries the watch profile's entitlements — its
    # application-identifier must match the profile embedded in the watch
    # bundle or the watch rejects the install.
    if [[ -d "$app_path/Watch" ]]; then
        local watch_entitlements="${WATCH_ENTITLEMENTS_PLIST:-$entitlements}"
        while read -r watchapp; do
            while read -r item; do
                codesign --force --sign "$identity" --keychain "$keychain" --timestamp=none "$item" >>"$log" 2>&1
                count=$((count + 1))
            done < <(find "$watchapp" \( -name "*.dylib" -o -name "*.framework" \))
            if [[ -d "$watchapp/PlugIns" ]]; then
                while read -r appex; do
                    codesign --force --sign "$identity" --keychain "$keychain" \
                        --entitlements "$watch_entitlements" --timestamp=none "$appex" >>"$log" 2>&1
                    count=$((count + 1))
                done < <(find "$watchapp/PlugIns" -maxdepth 1 -name '*.appex' -type d)
            fi
            codesign --force --sign "$identity" --keychain "$keychain" \
                --entitlements "$watch_entitlements" --timestamp=none "$watchapp" >>"$log" 2>&1
            count=$((count + 1))
        done < <(find "$app_path/Watch" -maxdepth 1 -name '*.app' -type d)
    fi

    # Sign the main app bundle with entitlements
    codesign --force --sign "$identity" --keychain "$keychain" \
        --entitlements "$entitlements" --timestamp=none "$app_path" >>"$log" 2>&1
    count=$((count + 1))

    SIGNED_COUNT="$count"
}

# --- Main ---

cd "$PROJECT_ROOT"

# Everything below writes build/, so one run per checkout at a time. --sign-dylib
# (what `inject` calls, possibly while a build runs) only appends to the log.
if (( ${#SIGN_DYLIBS[@]} == 0 )); then
    acquire_build_lock
    : > "$LOG_FILE"
fi

# --sign-dylib: sign loose Mach-O files with the development identity and stop.
# A live patch (DebugTrace `inject`) is loaded by the running app, and the OS
# only loads a dylib signed by the team that signed the app. Same temporary
# keychain and lock as a full signing run; nothing about the identity is printed.
if (( ${#SIGN_DYLIBS[@]} > 0 )); then
    acquire_signing_lock
    setup_signing_keychain "$P12_PATH" "$P12_PW"
    for f in "${SIGN_DYLIBS[@]}"; do
        [[ -f "$f" ]] || { echo "ERROR: not a file: $f" >&2; exit 1; }
        codesign --force --sign "$SIGN_IDENTITY" --keychain "$KEYCHAIN_PATH" --timestamp=none "$f" >>"$LOG_FILE" 2>&1
        echo "signed $f"
    done
    exit 0
fi

IPA_PATH="$BUILD_DIR/${TARGET_NAME}.ipa"
BUILD_ID="$(/usr/bin/python3 -c 'import uuid; print(uuid.uuid4().hex)')"
BAS_INFRA_ROOT="$(/usr/bin/python3 -c 'import os,sys; print(os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1]))))' "$0")"
MANIFEST_TOOL="$BAS_INFRA_ROOT/bin/build-manifest"
if ! command -v node >/dev/null || [[ ! -f "$MANIFEST_TOOL" ]]; then
    echo "ERROR: build-and-sign needs Node 18+ and the complete build tools checkout to record artifacts" >&2
    exit 1
fi
SOURCE_BEFORE=""
SOURCE_AFTER=""

# Step 1: Build (unless --sign-only)
if [[ "$SIGN_ONLY" == false ]]; then
    prune_legacy_derived_data

    # Figure out whether PROJECT_PATH is a project or a workspace
    case "$PROJECT_PATH" in
        *.xcworkspace) PROJECT_FLAG="-workspace" ;;
        *.xcodeproj)   PROJECT_FLAG="-project" ;;
        *) echo "ERROR: PROJECT_PATH must end in .xcodeproj or .xcworkspace" >&2; exit 1 ;;
    esac

    if [[ -n "$PRE_BUILD_HOOK" ]]; then
        echo "==> Running pre-build hook: $PRE_BUILD_HOOK" >>"$LOG_FILE"
        # shellcheck disable=SC2086
        ( cd "$PROJECT_ROOT" && eval $PRE_BUILD_HOOK ) >>"$LOG_FILE" 2>&1
    fi

    # One argument list, used both to build and to ask where the product
    # went. If these two ever drift apart (a --set that reaches only the
    # build, say) the query starts describing a different build than the one
    # that ran, which is the whole failure mode this replaced.
    XCB_ARGS=(
        "$PROJECT_FLAG" "$PROJECT_PATH"
        -scheme "$SCHEME_NAME"
        -configuration "$CONFIG"
        -destination "generic/platform=$PLATFORM"
        -derivedDataPath "$DERIVED_DATA_PATH"
        CODE_SIGN_IDENTITY="-"
        CODE_SIGNING_REQUIRED=NO
        CODE_SIGNING_ALLOWED=NO
        DEVELOPMENT_TEAM=""
        PROVISIONING_PROFILE_SPECIFIER=""
        ${EXTRA_BUILD_SETTINGS[@]+"${EXTRA_BUILD_SETTINGS[@]}"}
    )
    # --inject: make functions replaceable at runtime (DebugTrace `inject`).
    # Testability exports every symbol a patch has to name, implicit-dynamic
    # makes each function replaceable, private-imports lets a patch reach the
    # file-private members of the code it replaces. Packages are built with
    # the same flags, since OTHER_SWIFT_FLAGS on the command line reaches them.
    if [[ "$INJECT" == true ]]; then
        if [[ "${DEBUGTRACE_INJECT:-}" == off ]]; then
            echo "ERROR: this repo's build-signing.conf sets DEBUGTRACE_INJECT=off, so --inject is refused" >&2
            exit 1
        fi
        if [[ "$USE_DIST" == true ]]; then
            echo "ERROR: --inject cannot be combined with --distribution" >&2
            exit 1
        fi
        # DEAD_CODE_STRIPPING=NO keeps symbols nothing in the build references,
        # which a patch (or the embedded runtime) may name.
        # INJECT_SCOPE=app (conf) limits this to the app target: settings given
        # on the command line reach every target, packages included, so the
        # flags hide behind a macro named after WRAPPER_EXTENSION, which is
        # "app" only for the app (packages leave it empty). Package code then
        # keeps full optimization (games' hot loops live there) but cannot be
        # patched; debugtrace-inject says so and asks for INJECT_SCOPE=all.
        if [[ "${INJECT_SCOPE:-all}" == app ]]; then
            XCB_ARGS+=(DEAD_CODE_STRIPPING=NO
                       'DTINJECT_TESTABILITY_app=YES' 'ENABLE_TESTABILITY=$(DTINJECT_TESTABILITY_$(WRAPPER_EXTENSION))'
                       'DTINJECT_FLAGS_app=-Xfrontend -enable-implicit-dynamic -Xfrontend -enable-private-imports'
                       'OTHER_SWIFT_FLAGS=$(inherited) $(DTINJECT_FLAGS_$(WRAPPER_EXTENSION))')
        else
            XCB_ARGS+=(ENABLE_TESTABILITY=YES DEAD_CODE_STRIPPING=NO
                       'OTHER_SWIFT_FLAGS=$(inherited) -Xfrontend -enable-implicit-dynamic -Xfrontend -enable-private-imports')
        fi
    fi

    SOURCE_BEFORE="$WORK_DIR/source-before.json"
    SOURCE_AFTER="$WORK_DIR/source-after.json"
    printf '%s\0' "${XCB_ARGS[@]}" > "$WORK_DIR/build-arguments"
    node "$MANIFEST_TOOL" snapshot "$PROJECT_ROOT" "$SOURCE_BEFORE" "$WORK_DIR/build-arguments"

    if [[ "$INJECT" == true ]]; then
        echo "==> Building for $PLATFORM ($CONFIG) for live patching..."
    else
        echo "==> Building for $PLATFORM ($CONFIG)..."
    fi
    if [[ "$INJECT" == true ]]; then
        # Not -quiet: the compiler's command lines in this log are what
        # `inject` replays to compile a patch exactly as the app was compiled.
        xcodebuild "${XCB_ARGS[@]}" build >>"$LOG_FILE" 2>&1
    else
        xcodebuild -quiet "${XCB_ARGS[@]}" build >>"$LOG_FILE" 2>&1
    fi
    echo "  Build succeeded."
    node "$MANIFEST_TOOL" snapshot "$PROJECT_ROOT" "$SOURCE_AFTER" "$WORK_DIR/build-arguments"

    # --- Locate the product ------------------------------------------------
    # Globbing DerivedData for the .app has now failed three separate ways,
    # each one ending with the WRONG binary packaged and pushed to a device:
    #   1. the other configuration's products  (Debug-xros vs Release-xros)
    #   2. a product left over from a previous product/target name
    #   3. another platform's products — Release-iphoneos and Release-xros
    #      both match "$CONFIG-*", and `find` yielded xros first, so every
    #      iOS/iPad build packaged the visionOS app; devicectl then
    #      refused it with CoreDeviceError 3002 (DeviceFamilyNotSupported).
    # Each fix narrowed the glob, and the next variable it hadn't accounted
    # for broke it again. So stop guessing: ask xcodebuild where it just put
    # the product. BUILT_PRODUCTS_DIR/FULL_PRODUCT_NAME already account for
    # configuration, SDK, platform, product name and any --set override.
    APP_PATH=""
    CODE_SIGN_ENTITLEMENTS_PATH=""
    XCODE_PROJECT_DIR=""
    if SETTINGS_JSON=$(xcodebuild -showBuildSettings -json "${XCB_ARGS[@]}" 2>/dev/null); then
        SETTINGS_RESULT=$(BAS_TARGET="$TARGET_NAME" python3 -c '
import json, os, sys
raw = sys.stdin.read()
start = raw.find("[")
if start < 0:
    sys.exit(0)
try:
    entries = json.loads(raw[start:])
except ValueError:
    sys.exit(0)
want = os.environ.get("BAS_TARGET", "")
chosen = next((e for e in entries if e.get("target") == want), None)
if chosen is None and entries:
    chosen = entries[0]
if chosen is None:
    sys.exit(0)
bs = chosen.get("buildSettings", {})
d = bs.get("BUILT_PRODUCTS_DIR", "")
n = bs.get("FULL_PRODUCT_NAME") or bs.get("WRAPPER_NAME") or ""
if d and n.endswith(".app"):
    print(os.path.join(d, n))
print(bs.get("CODE_SIGN_ENTITLEMENTS", ""))
print(bs.get("PROJECT_DIR", ""))
' <<<"$SETTINGS_JSON")
        APP_PATH="$(printf '%s\n' "$SETTINGS_RESULT" | sed -n '1p')"
        CODE_SIGN_ENTITLEMENTS_PATH="$(printf '%s\n' "$SETTINGS_RESULT" | sed -n '2p')"
        XCODE_PROJECT_DIR="$(printf '%s\n' "$SETTINGS_RESULT" | sed -n '3p')"
    fi
    if [[ -n "$APP_PATH" && ! -d "$APP_PATH" ]]; then
        echo "WARNING: xcodebuild reported a product that is not on disk: $APP_PATH" >&2
        APP_PATH=""
    fi

    # Fallback only for when -showBuildSettings itself fails. Constrained by
    # platform as well as configuration so it cannot repeat failure #3.
    PRODUCTS_DIR="$DERIVED_DATA_PATH/Build/Products"
    if [[ -z "$APP_PATH" ]]; then
        APP_PATH=$(find "$PRODUCTS_DIR" -maxdepth 2 -type d -name "${TARGET_NAME}.app" -path "*/${PRODUCT_SUBDIR}/*" 2>/dev/null | head -1)
        if [[ -z "$APP_PATH" ]]; then
            APP_PATH=$(find "$PRODUCTS_DIR" -maxdepth 2 -type d -name '*.app' -path "*/${PRODUCT_SUBDIR}/*" 2>/dev/null | head -1)
            [[ -n "$APP_PATH" ]] && echo "WARNING: ${TARGET_NAME}.app not found; using $(basename "$APP_PATH") (product name != TARGET_NAME?)"
        fi
    fi
    if [[ -z "$APP_PATH" ]]; then
        echo "ERROR: No .app bundle found in $PRODUCTS_DIR/${PRODUCT_SUBDIR}" >&2
        exit 1
    fi
    # --inject: record how each module was compiled, and the sources as they
    # were compiled, for the `inject` tool (see DebugTrace/Tools/debugtrace-inject).
    INJECT_DIR=""
    if [[ "$INJECT" == true ]]; then
        INJECT_TOOL="${DEBUGTRACE_INJECT_TOOL:-$HOME/Projects/DebugTrace/Tools/debugtrace-inject/debugtrace-inject}"
        if [[ ! -x "$INJECT_TOOL" ]]; then
            echo "ERROR: --inject needs $INJECT_TOOL (DebugTrace); set DEBUGTRACE_INJECT_TOOL if it lives elsewhere" >&2
            exit 1
        fi
        "$INJECT_TOOL" capture --log "$LOG_FILE" --out "$BUILD_DIR/inject" --root "$PROJECT_ROOT" \
            --app-module "$TARGET_NAME" --products "$(dirname "$APP_PATH")" --scope "${INJECT_SCOPE:-all}" >>"$LOG_FILE" 2>&1 \
            || { echo "ERROR: could not record the build for live patching (see $LOG_FILE)" >&2; exit 1; }
        INJECT_DIR="$BUILD_DIR/inject"
    fi
    # An earlier bas embedded the runtime into DerivedData's product itself,
    # where an incremental build without --inject kept it.
    rm -f "$APP_PATH/Frameworks/DebugTraceInject.dylib"
    if [[ "$MACOS_BUILD" == true ]]; then
        # Named after the product, not TARGET_NAME: a target's product name can
        # differ (OneirosDesktop builds Oneiros.app), and the appstore zips this
        # copy under its name minus "-macOS".
        MACOS_APP_PATH="$BUILD_DIR/$(basename "$APP_PATH" .app)-macOS.app"
        rm -rf "$MACOS_APP_PATH"
        cp -R "$APP_PATH" "$MACOS_APP_PATH"
        APP_PATH="$MACOS_APP_PATH"
    else
        rm -rf "$BUILD_DIR/Payload"
        mkdir -p "$BUILD_DIR/Payload"
        cp -R "$APP_PATH" "$BUILD_DIR/Payload/"
    fi
    if [[ "$INJECT" == true ]]; then
        # Embed the patch runtime, compiled with the app's own flags, so the app
        # needs no DebugTraceInject dependency: DebugTraceServer loads it when
        # present. Into the packaged copy only, never DerivedData's product, so
        # the next build without --inject cannot carry it. Signed with
        # everything else in Frameworks/ at Step 4.
        if [[ "$MACOS_BUILD" == true ]]; then
            PAYLOAD_APP="$APP_PATH"
        else
            PAYLOAD_APP="$BUILD_DIR/Payload/$(basename "$APP_PATH")"
        fi
        mkdir -p "$PAYLOAD_APP/Frameworks"
        "$INJECT_TOOL" runtime --dir "$INJECT_DIR" --out "$PAYLOAD_APP/Frameworks/DebugTraceInject.dylib" >>"$LOG_FILE" 2>&1 \
            || { echo "ERROR: could not build the live-patching runtime (see $LOG_FILE)" >&2; exit 1; }
    fi
    if [[ "$MACOS_BUILD" == false ]]; then
        ( cd "$BUILD_DIR" && rm -f "${TARGET_NAME}.ipa" && zip -qr "${TARGET_NAME}.ipa" Payload )
    fi
fi

# Use custom IPA path if specified
if [[ -n "$INPUT_IPA" ]]; then
    IPA_PATH="$INPUT_IPA"
fi

if [[ "$MACOS_BUILD" == false && ! -f "$IPA_PATH" ]]; then
    echo "ERROR: IPA not found at $IPA_PATH" >&2
    exit 1
fi

# Step 2: Import signing cert into a temporary keychain
acquire_signing_lock
setup_signing_keychain "$P12_PATH" "$P12_PW" >>"$LOG_FILE" 2>&1

# Step 3: Extract entitlements from the provisioning profile (mobile) or
# Xcode's target entitlements file (macOS does not use UDID-bound profiles).
ENTITLEMENTS_PLIST="$WORK_DIR/entitlements.plist"
if [[ "$MACOS_BUILD" == true ]]; then
    if [[ -z "$CODE_SIGN_ENTITLEMENTS_PATH" ]]; then
        printf '<?xml version="1.0" encoding="UTF-8"?>\n<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n<plist version="1.0"><dict/></plist>\n' >"$ENTITLEMENTS_PLIST"
    else
        [[ "$CODE_SIGN_ENTITLEMENTS_PATH" = /* ]] || CODE_SIGN_ENTITLEMENTS_PATH="${XCODE_PROJECT_DIR:-$PROJECT_ROOT}/$CODE_SIGN_ENTITLEMENTS_PATH"
        [[ -f "$CODE_SIGN_ENTITLEMENTS_PATH" ]] || {
            echo "ERROR: Xcode entitlements file not found: $CODE_SIGN_ENTITLEMENTS_PATH" >&2
            exit 1
        }
        cp "$CODE_SIGN_ENTITLEMENTS_PATH" "$ENTITLEMENTS_PLIST"
    fi
else
    extract_entitlements "$PROFILE_PATH" "$ENTITLEMENTS_PLIST"
    merge_extra_entitlements "$ENTITLEMENTS_PLIST" "${EXTRA_ENTITLEMENTS_PLIST:-}" >>"$LOG_FILE" 2>&1
    substitute_associated_domains "$ENTITLEMENTS_PLIST" "${ASSOCIATED_DOMAINS:-}" >>"$LOG_FILE" 2>&1
fi
WATCH_ENTITLEMENTS_PLIST=""
if [[ -n "$WATCH_PROFILE_PATH" ]]; then
    WATCH_ENTITLEMENTS_PLIST="$WORK_DIR/entitlements-watch.plist"
    extract_entitlements "$WATCH_PROFILE_PATH" "$WATCH_ENTITLEMENTS_PLIST"
    merge_extra_entitlements "$WATCH_ENTITLEMENTS_PLIST" "${EXTRA_ENTITLEMENTS_PLIST:-}" >>"$LOG_FILE" 2>&1
    substitute_associated_domains "$WATCH_ENTITLEMENTS_PLIST" "${ASSOCIATED_DOMAINS:-}" >>"$LOG_FILE" 2>&1
fi
# The extension's own entitlements, so it claims its own App ID rather than
# the app's. No associated-domains substitution: that is an app-level grant.
APPEX_ENTITLEMENTS_PLIST=""
if [[ -n "$APPEX_PROFILE_PATH" ]]; then
    APPEX_ENTITLEMENTS_PLIST="$WORK_DIR/entitlements-appex.plist"
    extract_entitlements "$APPEX_PROFILE_PATH" "$APPEX_ENTITLEMENTS_PLIST"
    merge_extra_entitlements "$APPEX_ENTITLEMENTS_PLIST" "${EXTRA_ENTITLEMENTS_PLIST:-}" >>"$LOG_FILE" 2>&1
fi

# Step 4: Unpack IPA
UNPACK_DIR="$WORK_DIR/unpack"
mkdir -p "$UNPACK_DIR"
if [[ "$MACOS_BUILD" == true ]]; then
    APP_BUNDLE="$MACOS_APP_PATH"
else
    unzip -qo "$IPA_PATH" -d "$UNPACK_DIR"
    APP_BUNDLE=$(find "$UNPACK_DIR/Payload" -name '*.app' -type d -maxdepth 1 | head -1)
fi
if [[ -z "$APP_BUNDLE" ]]; then
    echo "ERROR: No .app found in IPA" >&2
    exit 1
fi
APP_INFO_PLIST="$APP_BUNDLE/Info.plist"
[[ -f "$APP_BUNDLE/Contents/Info.plist" ]] && APP_INFO_PLIST="$APP_BUNDLE/Contents/Info.plist"
ORIGINAL_BUNDLE_ID="$(plutil -extract CFBundleIdentifier raw -o - "$APP_INFO_PLIST")"

# Step 4.1: refuse to sign a bundle that was built for a different platform.
# This is the backstop for the entire "wrong .app shipped to the device"
# class, and it sits here because this is the one point every path converges
# on: a fresh build, a --sign-only re-sign of whatever IPA was left in
# build/, and an explicit --ipa. Wherever the bundle came from, its own
# DTPlatformName has to be the SDK for the platform we were asked to ship.
# A mismatch fails loudly here instead of surfacing minutes later as a
# CoreDeviceError from devicectl — or, worse, installing a stale-but-
# compatible binary that looks like it worked.
#
# One mismatch is legitimate: Vision Pro runs iPad apps in compatibility mode,
# so an explicit --ipa of an iPad build (UIDeviceFamily includes 2) may go to
# a visionOS device. Verified installing iPhone/iPad IPAs on a Vision Pro. Fresh builds stay strict: there
# an iphoneos product for a visionOS run still means a stale DerivedData.
if [[ -n "$EXPECTED_SDK" && -f "$APP_INFO_PLIST" ]]; then
    BUILT_SDK=$(plutil -extract DTPlatformName raw -o - "$APP_INFO_PLIST" 2>/dev/null || true)
    if [[ -n "$INPUT_IPA" && "$BUILT_SDK" == "iphoneos" && "$EXPECTED_SDK" == "xros" ]] \
        && plutil -extract UIDeviceFamily json -o - "$APP_INFO_PLIST" 2>/dev/null | grep -q '\b2\b'; then
        echo "==> iPad build on a visionOS device: it will run in iPad compatibility mode."
        BUILT_SDK="$EXPECTED_SDK"
    fi
    if [[ -n "$BUILT_SDK" && "$BUILT_SDK" != "$EXPECTED_SDK" ]]; then
        echo "ERROR: this bundle was built for '$BUILT_SDK', but the requested platform is '$PLATFORM' (SDK '$EXPECTED_SDK')." >&2
        echo "       IPA:    $IPA_PATH" >&2
        echo "       Bundle: $(basename "$APP_BUNDLE")" >&2
        echo "       Installing it would fail on device as CoreDeviceError 3002 (DeviceFamilyNotSupported)." >&2
        if [[ "$SIGN_ONLY" == true || -n "$INPUT_IPA" ]]; then
            echo "       This run re-signs an existing IPA; that IPA is from another platform's build." >&2
        else
            echo "       Stale DerivedData product — remove $DERIVED_DATA_PATH/Build/Products and rebuild." >&2
        fi
        exit 1
    fi
fi

# Step 4.5: Enforce bundle identities. A command-line
# PRODUCT_BUNDLE_IDENTIFIER override would hit EVERY target (an app
# extension would clone the app's ID → installd DuplicateIdentifier), so the
# IDs are patched per-bundle here instead.
# An --ipa keeps the IPA's own bundle ID unless the caller set BUILD_BUNDLE_ID: the conf's
# default is for the repo's build, and stamping it on another app replaced that app's
# install with this one (Madeira over Apparition, 2026-10-15).
if [[ -n "$INPUT_IPA" && -z "$ENV_BUILD_BUNDLE_ID" ]]; then
    BUILD_BUNDLE_ID=$(plutil -extract CFBundleIdentifier raw -o - "$APP_INFO_PLIST")
elif [[ -z "${BUILD_BUNDLE_ID:-}" ]]; then
    BUILD_BUNDLE_ID=$(plutil -extract CFBundleIdentifier raw -o - "$APP_INFO_PLIST")
fi
if [[ -z "${HAS_DEBUGTRACE:-}" ]]; then
    # Checked whether or not the conf names the bundle id: inside the branch
    # above, a conf with BUILD_BUNDLE_ID set skipped it and --mcp reported a
    # DebugTraceServer app as not linking it.
    # Whether the app links DebugTrace (statically, so its marker string is in
    # the main binary, an embedded framework, or, for --debug builds, Xcode's
    # <name>.debug.dylib, which holds the code while the main binary is a
    # stub). --log then asks it for its own compact log and its debug server
    # instead of the whole unified log.
    APP_EXECUTABLE=$(plutil -extract CFBundleExecutable raw -o - "$APP_INFO_PLIST" 2>/dev/null || true)
    # DEBUGTRACE_SERVER marks the server product, which only apps with a
    # debug server link.
    HAS_DEBUGTRACE=false
    HAS_DEBUG_SERVER=false
    for candidate in "$APP_BUNDLE/$APP_EXECUTABLE" "$APP_BUNDLE/Contents/MacOS/$APP_EXECUTABLE" "$APP_BUNDLE"/*.debug.dylib "$APP_BUNDLE"/Frameworks/*.framework/* "$APP_BUNDLE"/Contents/Frameworks/*.framework/*; do
        [[ -f "$candidate" ]] || continue
        /usr/bin/grep -qaF DEBUGTRACE_STDERR "$candidate" 2>/dev/null && HAS_DEBUGTRACE=true
        /usr/bin/grep -qaF DEBUGTRACE_SERVER "$candidate" 2>/dev/null && HAS_DEBUG_SERVER=true
    done
fi
plutil -replace CFBundleIdentifier -string "$BUILD_BUNDLE_ID" "$APP_INFO_PLIST"
# No PlugIns/ (app ships no extensions) must not abort the script: `find`
# exits 1 on a missing path and this assignment runs under `set -e`.
# ExtensionKit extensions (app-defined extension points) live in Extensions/
# instead of PlugIns/; either holds the one extension this handles.
APPEX_BUNDLE=""
for appex_dir in "$APP_BUNDLE/PlugIns" "$APP_BUNDLE/Extensions"; do
    if [[ -z "$APPEX_BUNDLE" && -d "$appex_dir" ]]; then
        APPEX_BUNDLE=$(find "$appex_dir" -maxdepth 1 -name '*.appex' -type d | head -1)
    fi
done
EXTENSION_ID=""
if [[ -n "$APPEX_BUNDLE" && -n "$INPUT_IPA" && -z "$ENV_BUILD_BUNDLE_ID" && -z "${APPEX_BUNDLE_ID:-}" ]]; then
    # An --ipa's extension keeps its own ID (it is not "<app>.broadcast" unless the IPA says so).
    EXTENSION_ID=$(plutil -extract CFBundleIdentifier raw -o - "$APPEX_BUNDLE/Info.plist")
elif [[ -n "$APPEX_BUNDLE" ]]; then
    EXTENSION_ID="${APPEX_BUNDLE_ID:-${BUILD_BUNDLE_ID}.broadcast}"
    plutil -replace CFBundleIdentifier -string "$EXTENSION_ID" "$APPEX_BUNDLE/Info.plist"
fi

# An embedded watchOS companion app keeps its OWN bundle id (installd routes
# it to the paired watch via WKCompanionAppBundleIdentifier, which must stay a
# prefix-match of the iOS app id — patching it would break the pairing). We
# only re-provision and re-stamp it, never rewrite its id.
WATCH_BUNDLE=""
WATCH_ID=""
if [[ -d "$APP_BUNDLE/Watch" ]]; then
    WATCH_BUNDLE=$(find "$APP_BUNDLE/Watch" -maxdepth 1 -name '*.app' -type d | head -1)
    [[ -n "$WATCH_BUNDLE" ]] && WATCH_ID=$(plutil -extract CFBundleIdentifier raw -o - "$WATCH_BUNDLE/Info.plist")
fi

# Step 4.6: Stamp the source commit into CFBundleVersion (build number) so
# any on-device inventory (devicectl device info apps) reveals exactly what
# was installed. Apple requires numeric build numbers only at App Store /
# TestFlight upload; installd accepts arbitrary strings for dev-signed
# installs. CFBundleShortVersionString (marketing version) is left alone.
# Skipped for --sign-only/--ipa: the IPA may not match the repo's HEAD.
GIT_STAMP=""
if [[ "$SIGN_ONLY" == false ]]; then
    GIT_STAMP=$(node "$MANIFEST_TOOL" stamp "$SOURCE_BEFORE" "$PROJECT_ROOT")
    if [[ -n "$GIT_STAMP" ]]; then
        plutil -replace CFBundleVersion -string "$GIT_STAMP" "$APP_INFO_PLIST"
        if [[ -n "$APPEX_BUNDLE" ]]; then
            plutil -replace CFBundleVersion -string "$GIT_STAMP" "$APPEX_BUNDLE/Info.plist"
        fi
        if [[ -n "$WATCH_BUNDLE" ]]; then
            plutil -replace CFBundleVersion -string "$GIT_STAMP" "$WATCH_BUNDLE/Info.plist"
        fi
    fi
fi

# Step 4.7: Give a DebugTrace app its own trace-signing key. Every dev build,
# whatever the flags, so the trace sheet's Upload works on a launch from the
# home screen too. A fresh Ed25519 pair per build: the private half goes into
# DebugTraceCredential.plist inside the bundle (sealed by the code signature
# in Step 6), the public half into the key ledger the appstore verifies
# uploads against (DEBUGTRACE_KEY_DIR, one JSON file per key). The private
# key ships in the IPA, so a signature proves "a build this Mac made, and
# which one", not "a genuine device". Not for --distribution: an App Store
# build's users can't reach a tailnet upload URL, and the key would be public.
# DEBUGTRACE_UPLOAD_URL (global.conf) is where the app POSTs traces; unset,
# traces are still signed but the sheet offers Share only.
#
# An app that links DebugTraceServer also gets a per-build CommandToken, its
# debug server's bearer token. The credential carrying one is what makes the
# server start on every launch of this build (not only under --mcp), so a
# client can attach to an app already running; the ledger record holds the
# same token, and the ledger file is mode 600 from then on. The Local
# Network and Bonjour keys the server needs are added to this build's
# Info.plist here, never to the app's own, so App Store builds don't carry
# them. DEBUGTRACE_SERVER=off in a conf skips all of it for that repo.
DEBUGTRACE_KEY_DIR="${DEBUGTRACE_KEY_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/debugtrace/keys}"
TRACE_KEY_ID=""
COMMAND_TOKEN=""
embed_trace_credential() {
    local openssl="" der plist resources build_no branch
    # LibreSSL (/usr/bin/openssl) has no Ed25519.
    for candidate in /opt/homebrew/bin/openssl /usr/local/bin/openssl "$(command -v openssl || true)"; do
        if [[ -x "$candidate" ]] && "$candidate" version 2>/dev/null | /usr/bin/grep -q '^OpenSSL [3-9]'; then
            openssl="$candidate"
            break
        fi
    done
    if [[ -z "$openssl" ]]; then
        echo "WARNING: no OpenSSL 3 found (brew install openssl); traces from this build won't be signed or uploadable" >&2
        return 0
    fi
    # The key never reaches stdout or the build log: it moves file to file.
    der="$WORK_DIR/trace-key.der"
    ( umask 077 && "$openssl" genpkey -algorithm ed25519 -outform DER -out "$der" ) >>"$LOG_FILE" 2>&1
    TRACE_KEY_ID="$BUILD_ID"
    if [[ "${HAS_DEBUG_SERVER:-false}" == true && "${DEBUGTRACE_SERVER:-}" != off ]]; then
        COMMAND_TOKEN="$("$openssl" rand -hex 24)"
    fi
    resources="$APP_BUNDLE"
    [[ -d "$APP_BUNDLE/Contents" ]] && resources="$APP_BUNDLE/Contents/Resources"
    mkdir -p "$resources"
    plist="$resources/DebugTraceCredential.plist"
    {
        printf '<?xml version="1.0" encoding="UTF-8"?>\n'
        printf '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        printf '<plist version="1.0">\n<dict>\n'
        printf '\t<key>Version</key>\n\t<integer>1</integer>\n'
        printf '\t<key>KeyID</key>\n\t<string>%s</string>\n' "$TRACE_KEY_ID"
        printf '\t<key>SigningKey</key>\n\t<string>%s</string>\n' "$(tail -c 32 "$der" | base64)"
        if [[ -n "${DEBUGTRACE_UPLOAD_URL:-}" ]]; then
            printf '\t<key>UploadURL</key>\n\t<string>%s</string>\n' "$DEBUGTRACE_UPLOAD_URL"
        fi
        if [[ -n "$COMMAND_TOKEN" ]]; then
            printf '\t<key>CommandToken</key>\n\t<string>%s</string>\n' "$COMMAND_TOKEN"
        fi
        printf '</dict>\n</plist>\n'
    } >"$plist"
    build_no=$(plutil -extract CFBundleVersion raw -o - "$APP_BUNDLE/Info.plist" 2>/dev/null \
        || plutil -extract CFBundleVersion raw -o - "$APP_BUNDLE/Contents/Info.plist" 2>/dev/null || true)
    branch=$(git -C "$PROJECT_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    mkdir -p "$DEBUGTRACE_KEY_DIR"
    TRACE_PUBLIC_KEY="$("$openssl" pkey -inform DER -in "$der" -pubout -outform DER 2>>"$LOG_FILE" | tail -c 32 | base64)" \
    TRACE_KEY_ID="$TRACE_KEY_ID" TRACE_BUNDLE_ID="$BUILD_BUNDLE_ID" TRACE_BUILD="$build_no" \
    TRACE_PLATFORM="$PLATFORM" TRACE_CONFIG="$CONFIG" TRACE_PROJECT="$PROJECT_ROOT" TRACE_BRANCH="$branch" \
    TRACE_DEVICE="${DEVICE_NAME:-}" TRACE_OUT="$DEBUGTRACE_KEY_DIR/$TRACE_KEY_ID.json" \
    TRACE_COMMAND_TOKEN="$COMMAND_TOKEN" \
    /usr/bin/python3 -c '
import json, os, time
e = os.environ
record = {
    "keyId": e["TRACE_KEY_ID"], "buildId": e["TRACE_KEY_ID"], "algorithm": "ed25519", "publicKey": e["TRACE_PUBLIC_KEY"],
    "bundleId": e["TRACE_BUNDLE_ID"], "build": e["TRACE_BUILD"], "platform": e["TRACE_PLATFORM"],
    "configuration": e["TRACE_CONFIG"], "project": e["TRACE_PROJECT"], "branch": e["TRACE_BRANCH"],
    "device": e["TRACE_DEVICE"], "createdAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
}
if e["TRACE_COMMAND_TOKEN"]:
    record["commandToken"] = e["TRACE_COMMAND_TOKEN"]
# Mode 600 whether or not it holds a token: created that way, never widened.
fd = os.open(e["TRACE_OUT"], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(record, f, indent=1)
'
    rm -f "$der"
}
# The keys the always-on debug server needs, added to this signed build only.
add_debug_server_plist_keys() {
    local info="$APP_BUNDLE/Info.plist"
    [[ -f "$APP_BUNDLE/Contents/Info.plist" ]] && info="$APP_BUNDLE/Contents/Info.plist"
    if ! /usr/libexec/PlistBuddy -c 'Print :NSLocalNetworkUsageDescription' "$info" >/dev/null 2>&1; then
        /usr/libexec/PlistBuddy -c "Add :NSLocalNetworkUsageDescription string Development builds serve a debug API on your local network." "$info"
    fi
    if ! /usr/libexec/PlistBuddy -c 'Print :NSBonjourServices' "$info" >/dev/null 2>&1; then
        /usr/libexec/PlistBuddy -c 'Add :NSBonjourServices array' "$info"
    fi
    if ! plutil -extract NSBonjourServices json -o - "$info" 2>/dev/null | /usr/bin/grep -qF '"_debugtrace._tcp"'; then
        /usr/libexec/PlistBuddy -c 'Add :NSBonjourServices: string _debugtrace._tcp' "$info"
    fi
}
if [[ "$HAS_DEBUGTRACE" == true && "$USE_DIST" == false ]]; then
    embed_trace_credential
    [[ -n "$TRACE_KEY_ID" ]] && echo "==> Trace key $TRACE_KEY_ID${DEBUGTRACE_UPLOAD_URL:+ (uploads to $DEBUGTRACE_UPLOAD_URL)}"
    if [[ -n "$COMMAND_TOKEN" ]]; then
        add_debug_server_plist_keys
        echo "==> Debug server on every launch (attach with the apps MCP tools or the appstore page)"
    fi
fi

# Step 5: Embed provisioning profile (app + extension; both bundles resolve
# their shared App Group from it at runtime)
if [[ "$MACOS_BUILD" == false ]]; then
    cp "$PROFILE_PATH" "$APP_BUNDLE/embedded.mobileprovision"
fi
if [[ -n "$APPEX_BUNDLE" ]]; then
    cp "${APPEX_PROFILE_PATH:-$PROFILE_PATH}" "$APPEX_BUNDLE/embedded.mobileprovision"
fi
if [[ -n "$WATCH_BUNDLE" ]]; then
    cp "${WATCH_PROFILE_PATH:-$PROFILE_PATH}" "$WATCH_BUNDLE/embedded.mobileprovision"
fi

# Step 5.5: Concretize a wildcard application-identifier. A wildcard profile's
# Entitlements carry the literal "TEAM.com.foo.*" — Xcode substitutes the real
# bundle id at sign time, and so must we: signing the literal wildcard gives
# every app the SAME identity string, so identity-routed surfaces (lock-screen
# Now Playing tap, widgets) open whichever app claimed it first, and installd
# rejects upgrades over an app signed with a different concrete id.
_concretize_wildcard_app_id() {
    local plist="$1" bundle_id="$2" appid team
    appid=$(/usr/libexec/PlistBuddy -c 'Print :application-identifier' "$plist" 2>/dev/null || true)
    if [[ "$appid" == *'.*' ]]; then
        team="${appid%%.*}"
        /usr/libexec/PlistBuddy -c "Set :application-identifier ${team}.${bundle_id}" "$plist"
    fi
}
# An embedded watch app keeps its own bundle id, so it needs its own
# concretized copy even when no separate watch profile is configured.
if [[ -n "$WATCH_ID" && -z "$WATCH_ENTITLEMENTS_PLIST" ]]; then
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :application-identifier' "$ENTITLEMENTS_PLIST" 2>/dev/null)" == *'.*' ]]; then
        WATCH_ENTITLEMENTS_PLIST="$WORK_DIR/entitlements-watch.plist"
        cp "$ENTITLEMENTS_PLIST" "$WATCH_ENTITLEMENTS_PLIST"
    fi
fi
if [[ "$MACOS_BUILD" == false ]]; then
    _concretize_wildcard_app_id "$ENTITLEMENTS_PLIST" "$BUILD_BUNDLE_ID"
fi
if [[ -n "$WATCH_ENTITLEMENTS_PLIST" && -n "$WATCH_ID" ]]; then
    _concretize_wildcard_app_id "$WATCH_ENTITLEMENTS_PLIST" "$WATCH_ID"
fi
# A no-op for an explicit App ID, which is the only reason to configure an
# appex profile at all; kept so the mechanism behaves the same either way.
if [[ -n "$APPEX_ENTITLEMENTS_PLIST" && -n "$EXTENSION_ID" ]]; then
    _concretize_wildcard_app_id "$APPEX_ENTITLEMENTS_PLIST" "$EXTENSION_ID"
fi

# Step 6: Sign
echo "==> Signing..."
sign_app "$APP_BUNDLE" "$SIGN_IDENTITY" "$ENTITLEMENTS_PLIST" "$KEYCHAIN_PATH" "$LOG_FILE"

# Step 7: Repack as signed IPA (macOS artifact remains the signed .app).
# Always into $BUILD_DIR under a name derived from TARGET_NAME (never next
# to whatever IPA_PATH happened to be) — one stable, overwritten-in-place
# location per repo, regardless of where the source IPA came from. This is
# what the appstore harness (server.js) already expects when it reads back
# version/build info: it scans "$buildCwd/build/*-signed.ipa". Writing
# anywhere else (e.g. next to a --ipa input) orphans that read and, worse,
# leaves a signed artifact sitting where a later find_static_ipa() scan
# could mistake it for fresh input.
if [[ "$MACOS_BUILD" == true ]]; then
    SIGNED_APP="$MACOS_APP_PATH"
else
    SIGNED_IPA="$BUILD_DIR/${TARGET_NAME}-signed.ipa"
    ( cd "$UNPACK_DIR" && rm -f "$SIGNED_IPA" && zip -qr "$SIGNED_IPA" Payload ) >>"$LOG_FILE" 2>&1
fi

# Step 8: Verify (logged only — codesign succeeding is implied by reaching
# here under set -e; the identity/team aren't worth a report line every run)
codesign -dvvv "$APP_BUNDLE" >>"$LOG_FILE" 2>&1

# Resolve DEVICE_NAME → devicectl UUID, once; both deploy and launch need it.
# Resolve by pattern, never by column position: the Hostname column is empty
# while a device sits in the `connected` state, which shifts every later field
# left and made `awk '{print $3}'` return the literal string "connected" as the
# identifier. Simulator rows are skipped since devicectl only installs to
# physical devices. `|| true` is required under `set -euo pipefail`, which
# would otherwise abort on grep's no-match exit before the friendly error
# below could run.
#
# Prefer the JSON listing over the table. The table is not stable either:
# while a device's tunnel is up (the `connected` state — i.e. the moment the
# headset is worn and unlocked) the Identifier column switches from the
# CoreDevice UUID to the hardware UDID (`00008142-… (UDID)`), which a UUID
# regex does not match, so the device was reported "not found" precisely when
# it was ready. JSON carries the UUID regardless of connection state, and
# `--device` accepts either identifier anyway.
DEVICE_ID=""
resolve_device_id() {
    if [[ -n "$DEVICE_ID" ]]; then return 0; fi
    local json
    json=$(xcrun devicectl list devices --json-output /dev/stdout 2>/dev/null || true)
    if [[ -n "$json" ]] && command -v python3 >/dev/null 2>&1; then
        DEVICE_ID=$(printf '%s' "$json" | DEVICE_NAME="$DEVICE_NAME" python3 -c '
import json, os, sys
name = os.environ["DEVICE_NAME"]
try:
    devices = json.load(sys.stdin)["result"]["devices"]
except Exception:
    sys.exit(0)
physical = [d for d in devices if d.get("hardwareProperties", {}).get("reality") != "simulated"]
exact = [d for d in physical if d.get("deviceProperties", {}).get("name") == name]
loose = [d for d in physical if name in d.get("deviceProperties", {}).get("name", "")]
for d in exact + loose:
    print(d["identifier"])
    break
' 2>/dev/null || true)
        if [[ -n "$DEVICE_ID" ]]; then return 0; fi
    fi
    # Fallback: the table, matching either identifier form (UUID or UDID).
    local device_list
    device_list=$(xcrun devicectl list devices 2>/dev/null || true)
    _device_uuid() {
        grep -v "simulated" \
            | grep -oiE '[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12}|[0-9A-F]{8}-[0-9A-F]{16}' \
            | head -1
    }
    # Prefer an exact match in the Name column, then fall back to a loose match
    # so configs that name a model substring keep working.
    DEVICE_ID=$(printf '%s\n' "$device_list" | grep -E "^${DEVICE_NAME}[[:space:]]" | _device_uuid || true)
    if [[ -z "$DEVICE_ID" ]]; then
        DEVICE_ID=$(printf '%s\n' "$device_list" | grep -F "$DEVICE_NAME" | _device_uuid || true)
    fi
    if [[ -z "$DEVICE_ID" ]]; then
        echo "ERROR: Device '$DEVICE_NAME' not found. Is it connected and paired?" >&2
        echo "Available devices:"
        xcrun devicectl list devices 2>/dev/null | grep -E "available|connected"
        exit 1
    fi
}

# Step 8.5: keep the dSYMs before installing or publishing this build.
# Immutable symbol sets are keyed by the build id, with a UUID index.
# Keep old app/device slots readable; a later build never rotates away symbols
# that a tester's delayed report may still need. Also archive --no-deploy builds.
source "$BAS_INFRA_ROOT/lib/symbols.sh"

# Retain symbols and an immutable artifact before any install. Terminal builds
# and build-on-download jobs use the same identity and manifest path.
if [[ "${HAS_DEBUGTRACE:-false}" == true && "$USE_DIST" == false \
      && "$SIGN_ONLY" == false && -n "${APP_PATH:-}" ]]; then
    archive_dsyms || echo "WARNING: could not keep the dSYMs of this build" >&2
fi
APPARITION_BUILD_DIR="${APPARITION_BUILD_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/apparition/builds}"
if [[ "$MACOS_BUILD" == true ]]; then MANIFEST_ARTIFACT="$SIGNED_APP"; else MANIFEST_ARTIFACT="$SIGNED_IPA"; fi
BAS_MANIFEST_APP="$APP_BUNDLE" BAS_MANIFEST_ARTIFACT="$MANIFEST_ARTIFACT" \
BAS_MANIFEST_PROJECT="$PROJECT_ROOT" BAS_MANIFEST_BEFORE="$SOURCE_BEFORE" BAS_MANIFEST_AFTER="$SOURCE_AFTER" \
BAS_MANIFEST_ID="$BUILD_ID" BAS_MANIFEST_KEY="$TRACE_KEY_ID" BAS_MANIFEST_PLATFORM="$PLATFORM" \
BAS_MANIFEST_CONFIG="$CONFIG" BAS_MANIFEST_ORIGINAL="$ORIGINAL_BUNDLE_ID" BAS_MANIFEST_STORE="$APPARITION_BUILD_DIR" \
BAS_MANIFEST_SYMBOLS="$DEBUGTRACE_DSYM_DIR/$BUILD_BUNDLE_ID@$BUILD_ID/uuids.json" \
/usr/bin/python3 -c '
import json, os, sys
e = os.environ
record = {key: e["BAS_MANIFEST_" + value] for key, value in {
    "app": "APP", "artifact": "ARTIFACT", "project": "PROJECT", "buildId": "ID", "keyId": "KEY",
    "platform": "PLATFORM", "configuration": "CONFIG", "originalBundleId": "ORIGINAL", "store": "STORE", "symbols": "SYMBOLS"}.items()}
record.update({key: e["BAS_MANIFEST_" + key.upper()] or None for key in ("before", "after")})
with open(sys.argv[1], "w") as handle:
    json.dump(record, handle)
' "$WORK_DIR/manifest-options.json"
BUILD_MANIFEST="$(node "$MANIFEST_TOOL" publish "$WORK_DIR/manifest-options.json")"

# Step 9: Deploy to device
if [[ "$MACOS_BUILD" == true ]]; then
    INSTALL_STATUS=""
else
    INSTALL_STATUS="skipped"
fi
if [[ "$NO_DEPLOY" == false ]]; then
    echo "==> Installing to $DEVICE_NAME..."
    resolve_device_id
    # devicectl talks to mobile_installation_proxy directly — it does not
    # trigger the notification_proxy device preflight that xcodebuild does,
    # so its own output is clean already; still logged in case of failure.
    xcrun devicectl device install app --device "$DEVICE_ID" "$SIGNED_IPA" >>"$LOG_FILE" 2>&1
    INSTALL_STATUS="installed"
fi

# Finds the app's DebugTrace debug server after a --log launch and writes how
# to reach it to build/debug-server.txt. The port comes from the server's own
# "listening on port N" line in the console log. The address tried first is
# the device's name lowercased, which is its tailnet name (AVP → avp). The
# CoreDevice tunnel's address (devicectl's tunnelIPAddress) is the fallback; it
# routes to any port on the device. The result goes into a session record under
# ~/.local/state/debugtrace/sessions, which the agents' single `apps` MCP server
# (DebugTrace/Tools/debugtrace-mcp) routes by, so no agent config changes per app. Some apps start the server
# only later (for example once a document or level loads), so a miss here is not an error.
DEBUG_SERVER_URL=""
DEBUG_SERVER_NOTE=""
find_debug_server() {
    local port="" addresses="" address url name info_json
    for _ in $(seq 1 20); do
        port=$(/usr/bin/grep -Eo 'listening on port [0-9]+' "$APP_LOG" 2>/dev/null | head -1 | /usr/bin/grep -Eo '[0-9]+$' || true)
        [[ -n "$port" ]] && break
        sleep 1
    done
    addresses=$(echo "$DEVICE_NAME" | tr '[:upper:]' '[:lower:]')
    info_json=$(mktemp -t bas-device)
    if xcrun devicectl device info details --device "$DEVICE_ID" --json-output "$info_json" >/dev/null 2>&1; then
        addresses="$addresses
$(python3 -c '
import json, sys
props = json.load(open(sys.argv[1])).get("result", {}).get("connectionProperties", {})
seen = []
for value in [props.get("tunnelIPAddress")] + props.get("localHostnames", []):
    if value and value not in seen:
        seen.append(value)
print("\n".join(seen))
' "$info_json" 2>/dev/null || true)"
    fi
    rm -f "$info_json"
    if [[ -z "$port" ]]; then
        DEBUG_SERVER_NOTE="not up yet (no 'listening on port' line in 20 s); device address: $(echo "$addresses" | head -1)"
        return
    fi
    while IFS= read -r address; do
        [[ -z "$address" ]] && continue
        if [[ "$address" == *:* ]]; then url="http://[$address]:$port"; else url="http://$address:$port"; fi
        if curl -s -m 3 -o /dev/null -w '%{http_code}' "$url/" 2>/dev/null | /usr/bin/grep -q '^200$'; then
            DEBUG_SERVER_URL="$url"
            break
        fi
    done <<< "$addresses"
    if [[ -z "$DEBUG_SERVER_URL" ]]; then
        DEBUG_SERVER_NOTE="listening on port $port, but not reachable at: $(echo "$addresses" | tr '\n' ' ')"
        return
    fi
    # The session record: what debugtrace-mcp routes by. The console streamer's
    # pid is its liveness (devicectl --console exits when the app does).
    local sessions_dir="${XDG_STATE_HOME:-$HOME/.local/state}/debugtrace/sessions"
    local app_name session_file
    app_name=$(plutil -extract CFBundleDisplayName raw -o - "$APP_BUNDLE/Info.plist" 2>/dev/null \
        || plutil -extract CFBundleName raw -o - "$APP_BUNDLE/Info.plist" 2>/dev/null || echo "${BUILD_BUNDLE_ID##*.}")
    mkdir -p "$sessions_dir" && chmod 700 "${sessions_dir%/sessions}" "$sessions_dir"
    session_file="$sessions_dir/$BUILD_BUNDLE_ID@$DEVICE_NAME.json"
    ( umask 077
      BAS_BUNDLE="$BUILD_BUNDLE_ID" BAS_NAME="$app_name" BAS_DEVICE="$DEVICE_NAME" BAS_DEVICE_ID="$DEVICE_ID" \
      BAS_URL="$DEBUG_SERVER_URL" BAS_PID="$CONSOLE_PID" BAS_LOG="$APP_LOG" BAS_ROOT="$PROJECT_ROOT" \
      BAS_TOKEN="$MCP_TOKEN" BAS_KEY_ID="${COMMAND_TOKEN:+$TRACE_KEY_ID}" BAS_INJECT="${INJECT_DIR:-}" python3 -c '
import datetime, json, os, sys
e = os.environ
record = {"bundleId": e["BAS_BUNDLE"], "appName": e["BAS_NAME"], "device": e["BAS_DEVICE"],
          "deviceId": e["BAS_DEVICE_ID"], "url": e["BAS_URL"], "pid": int(e["BAS_PID"]),
          "consoleLog": e["BAS_LOG"], "projectRoot": e["BAS_ROOT"], "token": e["BAS_TOKEN"],
          "startedAt": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")}
# The key id lets other tools (the appstore page) find the token of this build in
# the ledger; only set when the launch token is that ledger token.
if e["BAS_KEY_ID"]:
    record["keyId"] = e["BAS_KEY_ID"]
# Where --inject recorded how this build was compiled; the `inject` tool needs it.
if e.get("BAS_INJECT"):
    record["injectDir"] = e["BAS_INJECT"]
with open(sys.argv[1], "w") as handle:
    json.dump(record, handle, indent=2)
' "$session_file" )
    {
        echo "# Debug server for $BUILD_BUNDLE_ID (this launch only)"
        echo "url: $DEBUG_SERVER_URL"
        echo "agents: use the \`apps\` MCP tools (apps, help, call, trace); the session is registered"
        echo "help: curl -s $DEBUG_SERVER_URL/   (the rest needs the session's bearer token)"
    } > "$BUILD_DIR/debug-server.txt"
}

# Step 10: Launch on device (--run / --log). --log attaches the app's console
# and streams it to a plain file so another process (or an LLM session) can
# read/tail it after this script exits — the devicectl process is nohup'd and
# disowned, and its pid is kept in a pidfile so the next run can stop it.
LAUNCH_STATUS=""
APP_LOG="$BUILD_DIR/device-console.log"
APP_LOG_PIDFILE="$BUILD_DIR/device-console.pid"
if [[ "$RUN_APP" == true ]]; then
    resolve_device_id
    # A console stream left over from a previous invocation would keep
    # appending interleaved output to the same file — stop it first. Verify
    # the pid still belongs to devicectl before killing: pids get recycled.
    if [[ -f "$APP_LOG_PIDFILE" ]]; then
        OLD_PID=$(cat "$APP_LOG_PIDFILE" 2>/dev/null || true)
        if [[ -n "$OLD_PID" ]] && ps -p "$OLD_PID" -o command= 2>/dev/null | grep -q devicectl; then
            kill "$OLD_PID" 2>/dev/null || true
        fi
        rm -f "$APP_LOG_PIDFILE"
    fi
    if [[ "$LOG_APP" == true ]]; then
        echo "==> Launching $BUILD_BUNDLE_ID (console → $APP_LOG)..."
        : > "$APP_LOG"
        rm -f "$BUILD_DIR/debug-server.txt"
        # DebugTrace apps (HAS_DEBUGTRACE) mirror their own log lines to stderr
        # when DEBUGTRACE_STDERR=1: only the app's lines, debug included, one
        # compact line each, private values withheld and secrets redacted,
        # which suits an LLM far better than the whole unified log.
        # devicectl supports DEVICECTL_CHILD_* variables, avoiding an inline
        # JSON argument. In particular, never put the MCP bearer token in argv:
        # the signed DebugTraceCredential already carries the same per-build
        # CommandToken used by debugtrace-mcp's session record.
        unset DEVICECTL_CHILD_DEBUGTRACE_TOKEN
        MCP_TOKEN=""
        if [[ "$MCP_SESSION" == true ]]; then
            if [[ "${HAS_DEBUG_SERVER:-false}" != true ]]; then
                # Only worth a warning when asked for: under MCP_DEFAULT=on an app
                # without the server just launches with its log.
                [[ "$MCP_REQUEST" == on ]] && echo "WARNING: --mcp: $BUILD_BUNDLE_ID doesn't link DebugTraceServer; launching with --log only" >&2
                MCP_SESSION=false
            else
                # DebugTraceServer authenticates with the signed credential's
                # CommandToken. That same per-build value is recorded below.
                MCP_TOKEN="$COMMAND_TOKEN"
                if [[ -z "$MCP_TOKEN" ]]; then
                    echo "ERROR: --mcp: $BUILD_BUNDLE_ID has no signed DebugTrace CommandToken" >&2
                    exit 1
                fi
            fi
        fi
        if [[ "${HAS_DEBUGTRACE:-false}" == true && "$LOG_ALL" == false ]]; then
            export DEVICECTL_CHILD_DEBUGTRACE_STDERR=1
            unset DEVICECTL_CHILD_OS_ACTIVITY_DT_MODE
        else
            unset DEVICECTL_CHILD_DEBUGTRACE_STDERR
            export DEVICECTL_CHILD_OS_ACTIVITY_DT_MODE=YES
        fi
        if [[ "$MCP_SESSION" == true ]]; then
            export DEVICECTL_CHILD_DEBUGTRACE_SERVER=1
        else
            unset DEVICECTL_CHILD_DEBUGTRACE_SERVER
        fi
        # --console alone bridges only stdout/stderr — os_log/Logger output
        # never reaches it and the file stays near-empty for apps that log
        # through the unified log. OS_ACTIVITY_DT_MODE=YES makes libtrace
        # mirror os_log to stderr (the same mechanism Xcode's console uses),
        # so both streams land in the file. Interpolations still honor
        # os_log privacy: values not marked `privacy: .public` read
        # "<private>" — that's the app's annotation, not a capture bug.
        nohup xcrun devicectl device process launch --console --terminate-existing \
            --device "$DEVICE_ID" "$BUILD_BUNDLE_ID" >>"$APP_LOG" 2>&1 &
        CONSOLE_PID=$!
        disown "$CONSOLE_PID"
        echo "$CONSOLE_PID" > "$APP_LOG_PIDFILE"
        # devicectl prints a "Launched application" line once the process is
        # up; an early exit with no such line is a launch failure. Alive but
        # quiet past the window still counts as launched — the marker text
        # varies across Xcode versions.
        LAUNCHED=false
        for _ in $(seq 1 30); do
            if grep -qi 'launched application' "$APP_LOG" 2>/dev/null; then
                LAUNCHED=true
                break
            fi
            if ! kill -0 "$CONSOLE_PID" 2>/dev/null; then break; fi
            sleep 1
        done
        if [[ "$LAUNCHED" == false ]] && ! kill -0 "$CONSOLE_PID" 2>/dev/null; then
            rm -f "$APP_LOG_PIDFILE"
            echo "ERROR: Failed to launch $BUILD_BUNDLE_ID on $DEVICE_NAME" >&2
            echo "---- console ----" >&2
            tail -15 "$APP_LOG" >&2
            exit 1
        fi
        LAUNCH_STATUS="log"
        if [[ "$MCP_SESSION" == true ]]; then
            find_debug_server
        fi
    else
        echo "==> Launching $BUILD_BUNDLE_ID..."
        xcrun devicectl device process launch --terminate-existing \
            --device "$DEVICE_ID" "$BUILD_BUNDLE_ID" >>"$LOG_FILE" 2>&1
        LAUNCH_STATUS="run"
    fi
fi

# --- Final report ---
echo ""
echo "=================== Install Report ===================="
printf '  %-12s %s\n' "App:" "$BUILD_BUNDLE_ID"
[[ -n "$EXTENSION_ID" ]] && printf '  %-12s %s\n' "Extension:" "$EXTENSION_ID"
[[ -n "$WATCH_ID" ]] && printf '  %-12s %s\n' "Watch:" "$WATCH_ID"
[[ -n "$GIT_STAMP" ]] && printf '  %-12s %s\n' "Build:" "$GIT_STAMP"
printf '  %-12s %s\n' "Build ID:" "$BUILD_ID"
printf '  %-12s %s\n' "Manifest:" "$BUILD_MANIFEST"
printf '  %-12s %s\n' "Config:" "$CONFIG"
printf '  %-12s %s items\n' "Signed:" "$SIGNED_COUNT"
if [[ "$MACOS_BUILD" == true ]]; then
    printf '  %-12s %s\n' "App path:" "$SIGNED_APP"
    printf '  %-12s copy this .app wherever you want\n' "Next step:"
else
    printf '  %-12s %s\n' "IPA:" "$SIGNED_IPA"
fi
case "$INSTALL_STATUS" in
    installed) printf '  %-12s ✓ installed on %s\n' "Status:" "$DEVICE_NAME" ;;
    skipped)   printf '  %-12s not deployed (install with: xcrun devicectl device install app --device <UDID> '"'"'%s'"'"')\n' "Status:" "$SIGNED_IPA" ;;
esac
case "$LAUNCH_STATUS" in
    run) printf '  %-12s ✓ running on %s\n' "Launched:" "$DEVICE_NAME" ;;
    log)
        printf '  %-12s ✓ running on %s with console attached\n' "Launched:" "$DEVICE_NAME"
        printf '  %-12s %s\n' "App log:" "$APP_LOG"
        printf '  %-12s kill $(cat %s)\n' "Stop log:" "$APP_LOG_PIDFILE"
        if [[ -n "$DEBUG_SERVER_URL" ]]; then
            printf '  %-12s %s  (agents: the \`apps\` MCP tools)\n' "Debug API:" "$DEBUG_SERVER_URL"
        elif [[ -n "$DEBUG_SERVER_NOTE" ]]; then
            printf '  %-12s %s\n' "Debug API:" "$DEBUG_SERVER_NOTE"
        fi
        ;;
esac
echo "========================================================="
